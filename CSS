.open {
  border: 2px solid black;
  background-color: #0D221B;
  color: white;
  display: flex;          /* Opening hours & Find us ni pakka pakkanu techukodaniki */
  gap: 70px;
  padding: 30px;
  width:1200px;
  margin-top:10px;
}

.hrs {
  display: flex;
  flex-direction: column;
  gap: 10px;              /* Rows madhya chinna gap */
}

/* Day and timing okate line lo ravadaniki */
.time-row {
  display: flex;
  gap: 20px;              /* Day ki, timing ki madhya gap */
  justify-content: space-between;
}

.hrs h2, .close h2 {
  margin-top: 0;
}

.close {
  display: flex;
  flex-direction: column;
  justify-content:flex-start;
}

.question-btn {
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 10px;
}

.question-btn img {
  width: 20px; /* Image size adjust chesukunanduku */
  height: 20px;
  transform:rotate(270deg);
}

/* Modata answers anni hide ayi untayi */
.answer {
  display: none;
  padding-left: 30px;
  color:purple;
  font-weight:bold;
  margin-bottom: 15px;
}

/* JavaScript dwara 'active' class add ayinappudu answer display avtundi */
.faq-item.active .answer {
  display: block;
}
