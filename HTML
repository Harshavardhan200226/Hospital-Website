<div class="box-container">
    <h2>Visit Planner</h2>
    <p>Describe the reason for your visit. This is a demo and not medical advice.</p>
    
    <label for="problem">Reason for visit</label>
    <textarea id="problem" placeholder="Describe your symptoms..."></textarea>
    
    <div class="checkbox-group">
        <label><input type="checkbox" class="urgent-check" value="chest pain"> chest pain</label>
        <label><input type="checkbox" class="urgent-check" value="severe breathing trouble"> severe breathing trouble</label>
        <label><input type="checkbox" class="urgent-check" value="face drooping"> face drooping</label>
        <label><input type="checkbox" class="urgent-check" value="heavy bleeding"> heavy bleeding</label>
    </div>
    
    <button class="b">Check Urgency</button>

    <!-- Dynamic Output Area -->
    <div id="result-box">
        <h3 id="result-title" style="margin: 0 0 8px 0; font-size: 18px;"></h3>
        <p id="result-desc" style="margin: 0; font-size: 14px;"></p>
        <p id="result-disclaimer" style="margin: 8px 0 0 0; font-size: 12px; font-style: italic;"></p>
    </div>
